@app.route('/api/generate', methods=['POST'])
def api_generate():
    data = request.get_json()
    length = data.get('length', 16)
    memorable = data.get('memorable', False)
    
    if memorable:
        password = PasswordGenerator.generate_memorable_password(data.get('words', 4))
    else:
        password = PasswordGenerator.generate_password(length)
    
    return jsonify({
        'password': password,
        'length': len(password),
        'type': 'memorable' if memorable else 'random'
    })

